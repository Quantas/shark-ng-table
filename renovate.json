{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Extends the sharkops-io org preset (1-day minimum release age, automerge for minor/patch). Rules below are specific to this Angular library.",
  "extends": [
    "local>sharkops-io/renovate-config",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "Update Angular framework, tooling and packager together",
      "matchPackageNames": ["@angular/**", "@angular-devkit/**", "@schematics/angular", "ng-packagr", "angular-eslint", "@angular-eslint/**"],
      "groupName": "Angular"
    },
    {
      "description": "Angular majors need `ng update` migrations and a peer range change: approve from the Dependency Dashboard (see RELEASING.md)",
      "matchPackageNames": ["@angular/**", "@angular-devkit/**", "@schematics/angular", "ng-packagr", "angular-eslint", "@angular-eslint/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "TypeScript is constrained by the Angular compiler; take new minors/majors with an Angular update, not on their own",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Library peer dependency ranges are maintained by hand",
      "matchFileNames": ["projects/shark-ng-table/package.json"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Test tooling",
      "matchPackageNames": ["vitest", "@vitest/**", "jsdom", "axe-core", "@axe-core/**", "@playwright/test"],
      "groupName": "test tooling"
    },
    {
      "description": "Lint tooling",
      "matchPackageNames": ["eslint", "@eslint/**", "typescript-eslint"],
      "groupName": "lint tooling"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
