{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "shark-ng-table": {
      "projectType": "library",
      "root": "projects/shark-ng-table",
      "sourceRoot": "projects/shark-ng-table/src",
      "prefix": "shark",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/shark-ng-table/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/shark-ng-table/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shark-ng-table/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/shark-ng-table/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/shark-ng-table/**/*.ts", "projects/shark-ng-table/**/*.html"]
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "root": "projects/docs",
      "sourceRoot": "projects/docs/src",
      "prefix": "docs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/docs",
            "browser": "projects/docs/src/main.ts",
            "tsConfig": "projects/docs/tsconfig.app.json",
            "loader": {
              ".md": "text"
            },
            "assets": [
              { "glob": "**/*", "input": "projects/docs/public" },
              { "glob": "**/*", "input": "projects/shark-ng-table/src/lib/style/fonts", "output": "fonts" }
            ],
            "styles": ["projects/docs/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "6kB", "maximumError": "10kB" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "docs:build:production" },
            "development": { "buildTarget": "docs:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/docs/**/*.ts", "projects/docs/**/*.html"]
          }
        }
      }
    }
  }
}
