{
  "name": "shark-ng-table-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for shark-ng-table (library) and its docs site.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "build": "ng build shark-ng-table && tsc -p projects/shark-ng-table/tsconfig.schematics.json && node scripts/finalize-package.mjs",
    "build:docs": "ng build docs",
    "test": "ng test shark-ng-table --watch=false",
    "test:watch": "ng test shark-ng-table",
    "test:coverage": "ng test shark-ng-table --watch=false --coverage",
    "test:schematics": "npm run build && tsc -p projects/shark-ng-table/tsconfig.schematics.spec.json && node --test \"out-tsc/schematics-spec/**/*.spec.js\"",
    "lint": "ng lint",
    "build:e2e": "ng build a11y-fixture && ng build docs",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:only": "playwright test"
  },
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@schematics/angular": "^22.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.1",
    "ng-packagr": "^22.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.9"
    }
  }
}
